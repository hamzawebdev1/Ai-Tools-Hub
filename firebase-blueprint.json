{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account information, preferences, favorites, and activity history",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photo": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "toolId": { "type": "string" },
              "toolName": { "type": "string" },
              "prompt": { "type": "string" },
              "output": { "type": "string" },
              "timestamp": { "type": "string" },
              "wordCount": { "type": "number" },
              "executionTimeMs": { "type": "number" }
            }
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "theme": { "type": "string" },
            "notifications": { "type": "boolean" }
          }
        },
        "role": { "type": "string" },
        "guestUsageCount": { "type": "number" },
        "registeredStatus": { "type": "boolean" }
      },
      "required": ["uid", "email", "registeredStatus"]
    },
    "keywords": {
      "title": "SEO Keyword",
      "description": "SEO keywords, target intent, tool/article mappings, and trend metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "keyword": { "type": "string" },
        "category": { "type": "string" },
        "searchIntent": { "type": "string" },
        "keywordType": { "type": "string" },
        "trendStatus": { "type": "string" },
        "searchVolumeNote": { "type": "string" },
        "contentOpportunity": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "mappedToolSlug": { "type": "string" },
        "mappedArticleSlug": { "type": "string" },
        "suggestedPage": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "keyword", "category", "searchIntent", "trendStatus", "priority"]
    }
  },
  "firestore": {
    "/keywords/{keywordId}": {
      "schema": { "$ref": "#/entities/keywords" },
      "description": "Collection of SEO keywords and trend opportunities"
    }
  }
}
