# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=

# APP_URL: Canonical host domain or Cloud Run service URL
APP_URL=https://aitoolshub.com

# JWT_SECRET: Strong secret key for signing JWT user tokens & CSRF tokens
JWT_SECRET=

# NODE_ENV: Server execution mode (production or development)
NODE_ENV=production
