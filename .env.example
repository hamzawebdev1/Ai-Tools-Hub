# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=

# APP_URL: Canonical host domain (https://mehzandigital.com)
APP_URL=https://mehzandigital.com

# JWT_SECRET: Strong secret key for signing JWT user tokens & CSRF tokens
JWT_SECRET=

# VITE_ADSENSE_CLIENT_ID: Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=

# NODE_ENV: Server execution mode (production or development)
NODE_ENV=production

