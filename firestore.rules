rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin"] ||
        request.auth.token.email == "hamza.web.dev5324@gmail.com" ||
        request.auth.token.email == "admin@security.hub" ||
        request.auth.token.email.endsWith("@mehzandigital.com") ||
        request.auth.token.email.endsWith("@aitoolshub.com")
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
    }

    match /tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletter/{subscriberId} {
      allow read, write: if true;
    }

    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    match /inbox/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_submissions/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /bug_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /feature_requests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /tool_events/{eventId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{eventId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}

