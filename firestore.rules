rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || request.auth.token.email == "admin@security.hub" || request.auth.token.email.endsWith("@aitoolshub.com"));
      allow list: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || request.auth.token.email == "admin@security.hub" || request.auth.token.email.endsWith("@aitoolshub.com"));
    }
  }
}
